# Copy this file only as a starting point. The normal local demo uses
# .env.master and .env.station.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=football

# Master: station publishes, master subscribes.
NODE_ROLE=master
STATION_ID=0
POSTGRES_PORT=5430
CONTAINER_NAME=football-master
NETWORK_NAME=football-net
NETWORK_ALIAS=master
STATION_HOST=station
STATION_PORT=5432
STATION_DB=football
