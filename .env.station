# .env.station — chạy trên máy trạm bạn bè (172.18.20.9)
# Master ở máy tôi: 172.18.20.106:5430
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=football
POSTGRES_PORT=5431
NODE_ROLE=station
STATION_ID=1
CONTAINER_NAME=football-station
NETWORK_NAME=football-net
NETWORK_ALIAS=station
REPLICATION_SLOT=master_slot
# Master (máy tôi) — pull ref.* master -> station
MASTER_HOST=172.18.20.106
MASTER_PORT=5430
MASTER_DB=football
# Địa chỉ master dùng để quay lại station này (demo.message station -> master).
# Station dùng 2 biến này để tự đăng ký subscription trên master, không 需要 master chạy lệnh.
STATION_PUBLIC_HOST=172.18.20.9
STATION_PUBLIC_PORT=5431
STATION_PUBLIC_DB=football
