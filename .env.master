# Master node - chạy trên máy của bạn (bạn = Trung tâm / VFF).
# Khi 6 bạn đã join ZeroTier & open station DB, set STATION<N>_HOST = IP ZeroTier của bạn N.
# Defaults dưới đây dùng docker service alias (cho dev local all-in-1), ZeroTier thực tế cần override.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=vleague_master
NETWORK_NAME=football-net

# ZeroTier IPs của 6 station (bạn bè) - override khi triển khai thực tế qua ZeroTier:
STATION1_HOST=station1
STATION2_HOST=station2
STATION3_HOST=station3
STATION4_HOST=station4
STATION5_HOST=station5
STATION6_HOST=station6

# Container của master - setup-fdw.sh dùng để psql exec:
MASTER_CONTAINER=football-master
