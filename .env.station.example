# Copy file này thành .env.station trên máy trạm của bạn bè.
# Mỗi bạn 1 STATION_ID (1..6):
#   1 = Hà Nội FC      (HNFC,    10.147.17.11)
#   2 = Công An HN     (CAHN,    10.147.17.12)
#   3 = Viettel        (VTT,     10.147.17.13)
#   4 = Hải Phòng FC   (HPFC,    10.147.17.14)
#   5 = Nam Định FC    (NDFC,    10.147.17.15)
#   6 = HAGL           (HAGL,    10.147.17.16)
#
# POSTGRES_DB đã fix theo STATION_ID - KHÔNG cần sửa (script tự động sinh).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5431
STATION_ID=1
NODE_ROLE=station
POSTGRES_DB=vleague_hnfc           # fix cho station_id=1; xem bảng mapping DB name bên dưới:
# STATION_ID=2 → POSTGRES_DB=vleague_cahn
# STATION_ID=3 → POSTGRES_DB=vleague_viettel
# STATION_ID=4 → POSTGRES_DB=vleague_haiphong
# STATION_ID=5 → POSTGRES_DB=vleague_namdinh
# STATION_ID=6 → POSTGRES_DB=vleague_hagl

NETWORK_NAME=football-net
